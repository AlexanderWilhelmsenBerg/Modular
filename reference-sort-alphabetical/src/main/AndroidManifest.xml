<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="io.github.alexanderwilhelmsenberg.modular" />
        <package android:name="io.github.alexanderwilhelmsenberg.modular.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AlphabeticalTheme">

        <activity
            android:name=".SortSettingsActivity"
            android:exported="true"
            android:label="@string/sort_settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AlphabeticalSortService"
            android:exported="true">
            <meta-data
                android:name="io.github.alexanderwilhelmsenberg.modular.MODULE_DESCRIPTOR"
                android:resource="@raw/module_descriptor" />
            <intent-filter>
                <action android:name="io.github.alexanderwilhelmsenberg.modular.action.MODULE" />
            </intent-filter>
        </service>
    </application>

</manifest>

