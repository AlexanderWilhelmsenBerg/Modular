<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.GridFixtureLargeProvider"
            android:exported="true"
            android:label="Large grid fixture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_fixture_large_widget" />
        </receiver>
        <receiver
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.GridFixtureSmallProvider"
            android:exported="true"
            android:label="Small grid fixture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_fixture_small_widget" />
        </receiver>
        <receiver
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.WorkspaceFixtureProvider"
            android:exported="true"
            android:label="Workspace fixture widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/workspace_fixture_widget" />
        </receiver>
        <receiver
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.ConfiguredWorkspaceFixtureProvider"
            android:exported="true"
            android:label="Configured workspace fixture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/workspace_configured_fixture_widget" />
        </receiver>
        <activity
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.WorkspaceFixtureConfigurationActivity"
            android:exported="false" />
        <provider
            android:name="io.github.alexanderwilhelmsenberg.modular.ui.WorkspaceFixtureControlProvider"
            android:authorities="io.github.alexanderwilhelmsenberg.modular.debug.test.workspacefixture"
            android:exported="true" />
    </application>
</manifest>
